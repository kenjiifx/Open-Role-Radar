---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title = 'OpenRoleRadar — Early-career roles from first-party ATS boards',
  description = 'Search internships, co-ops, and new-grad roles scraped directly from employer career pages — with real post dates and mobility signals.',
  canonicalPath = '',
  ogImage = '/og-default.png',
} = Astro.props;

const siteBase = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.href ?? 'https://kenjiifx.github.io';
const canonical = new URL(canonicalPath || '.', `${siteUrl}${siteBase}`).href;
const imageUrl = new URL(ogImage, `${siteUrl}${siteBase}`).href;
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="OpenRoleRadar" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href={`${siteBase}favicon.svg`} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a href={siteBase} class="site-logo" aria-label="OpenRoleRadar home">
          <span class="site-logo__mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle>
              <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.8"></circle>
              <circle cx="12" cy="12" r="1.6" fill="currentColor"></circle>
              <path d="M12 3v3M21 12h-3M12 21v-3M3 12h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </span>
          <span class="site-logo__text">OpenRoleRadar</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href={siteBase}>Search</a>
          <a href={`${siteBase}#roles`}>Live Feed</a>
          <a href={`${siteBase}status`}>Status</a>
          <a
            href="https://github.com/kenjiifx/Open-Role-Radar"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </nav>
        <div class="theme-switcher" role="group" aria-label="Theme">
          <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
          <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
          <button type="button" data-theme-choice="system" aria-pressed="true">Auto</button>
        </div>
        <a
          class="site-header__github"
          href="https://github.com/kenjiifx/Open-Role-Radar"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="OpenRoleRadar on GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 6.58 2 12.26c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85.004 1.71.12 2.51.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .26.18.59.69.48A10.27 10.27 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <strong>OpenRoleRadar</strong> — CS early-career roles from first-party ATS boards. Refresh
        reloads the live feed.
      </p>
    </footer>

    <script>
      import { applyTheme, loadPreferences, setTheme } from '../lib/storage';

      function syncThemeButtons(theme: string) {
        document.querySelectorAll('[data-theme-choice]').forEach((button) => {
          const el = button as HTMLButtonElement;
          const choice = el.dataset.themeChoice ?? 'system';
          el.setAttribute('aria-pressed', String(choice === theme));
        });
      }

      const initial = loadPreferences().theme;
      applyTheme(initial);
      syncThemeButtons(initial);

      document.querySelectorAll('[data-theme-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const choice = (button as HTMLButtonElement).dataset.themeChoice as
            | 'light'
            | 'dark'
            | 'system';
          setTheme(choice);
          applyTheme(choice);
          syncThemeButtons(choice);
        });
      });

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (loadPreferences().theme === 'system') applyTheme('system');
      });
    </script>
  </body>
</html>
