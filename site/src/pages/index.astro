---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobSearch from '../components/JobSearch';
---

<BaseLayout
  title="OpenRoleRadar — CS early-career roles from first-party ATS boards"
  description="Internships, co-ops, and new-grad software roles scraped from employer ATS boards — refreshed on every reload."
  canonicalPath=""
>
  <section class="hero">
    <p class="hero__eyebrow">First-party · CS track · Live feed</p>
    <h1 class="hero__brand">OpenRole<span>Radar</span></h1>
    <p class="hero__lead">
      Software internships and new-grad roles the moment public ATS boards post them.
      Reload this page anytime — the feed re-pulls instantly.
    </p>
  </section>

  <JobSearch client:load showStats />
</BaseLayout>
