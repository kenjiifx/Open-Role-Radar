---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobSearch from '../components/JobSearch';
---

<BaseLayout
  title="OpenRoleRadar — Early-career roles from first-party ATS boards"
  description="Search internships, co-ops, and new-grad roles scraped directly from employer career pages."
  canonicalPath=""
>
  <section class="hero">
    <h1 class="hero__brand">OpenRole<span>Radar</span></h1>
    <p class="hero__lead">
      Continuously discovers first-party ATS boards and polls them every few minutes.
      Refresh anytime — the live feed updates as soon as the latest sync finishes, not whenever
      Pages CDN happens to catch up.
    </p>
  </section>

  <JobSearch client:load showStats />
</BaseLayout>
