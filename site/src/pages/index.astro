---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobSearch from '../components/JobSearch';
---

<BaseLayout
  title="OpenRoleRadar — Early-career roles from first-party ATS boards"
  description="Search internships, co-ops, and new-grad roles scraped directly from employer career pages."
  canonicalPath=""
>
  <section class="hero">
    <h1 class="hero__brand">OpenRole<span>Radar</span></h1>
    <p class="hero__lead">
      Internships, co-ops, and new-grad roles from hundreds of first-party ATS boards —
      startups, mid-market, and big companies. Only open roles that still accept applications.
      Refresh anytime for the latest publish.
    </p>
  </section>

  <JobSearch client:load showStats />
</BaseLayout>
