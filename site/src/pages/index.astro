---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobSearch from '../components/JobSearch';
---

<BaseLayout
  title="OpenRoleRadar — Early-career roles from first-party ATS boards"
  description="Search internships, co-ops, and new-grad roles scraped directly from employer career pages."
  canonicalPath=""
>
  <section class="hero">
    <h1 class="hero__brand">OpenRole<span>Radar</span></h1>
    <p class="hero__lead">
      Early-career openings scraped from hundreds of first-party ATS boards the moment they
      appear — internships, co-ops, new-grad. Polled every few minutes. Only roles still accepting
      applications.
    </p>
  </section>

  <JobSearch client:load showStats />
</BaseLayout>
