---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { DataManifest } from '../lib/types';

const manifestPath = path.join(process.cwd(), 'public', 'data', 'manifest.json');
const manifest = fs.existsSync(manifestPath)
  ? (JSON.parse(fs.readFileSync(manifestPath, 'utf-8')) as DataManifest)
  : {
      version: 1,
      generated_at: '',
      total_jobs: 0,
      hash_buckets: 32,
      shards: [],
    };
---

<BaseLayout
  title="Status — OpenRoleRadar"
  description="OpenRoleRadar data pipeline status and manifest information."
  canonicalPath="status/"
>
  <section class="status-page">
    <h1>Platform status</h1>
    <p class="hero__lead">
      Static data health and manifest details for the OpenRoleRadar public dataset.
    </p>

    <dl class="status-grid">
      <div>
        <dt>Manifest version</dt>
        <dd>{manifest.version}</dd>
      </div>
      <div>
        <dt>Total jobs</dt>
        <dd>{manifest.total_jobs.toLocaleString()}</dd>
      </div>
      <div>
        <dt>Hash buckets</dt>
        <dd>{manifest.hash_buckets}</dd>
      </div>
      <div>
        <dt>Shards</dt>
        <dd>{manifest.shards.length}</dd>
      </div>
      <div>
        <dt>Last generated</dt>
        <dd>
          {manifest.generated_at ? (
            <time datetime={manifest.generated_at}>
              {new Date(manifest.generated_at).toLocaleString()}
            </time>
          ) : (
            '—'
          )}
        </dd>
      </div>
    </dl>

    {manifest.shards.length > 0 ? (
      <section>
        <h2>Shards</h2>
        <div class="table-wrap">
          <table class="job-table">
            <thead>
              <tr>
                <th scope="col">File</th>
                <th scope="col">Jobs</th>
                <th scope="col">Size</th>
              </tr>
            </thead>
            <tbody>
              {manifest.shards.map((shard) => (
                <tr>
                  <td>
                    <code>{shard.filename}</code>
                  </td>
                  <td>{shard.job_count}</td>
                  <td>{(shard.byte_size / 1024).toFixed(1)} KB</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <p class="empty-state">No job shards published yet. The dataset will appear after the first sync.</p>
    )}
  </section>
</BaseLayout>
