# Local development overrides (copy to .env — never commit .env)

# GitHub API token for discovery (optional locally; CI provides GITHUB_TOKEN)
# GITHUB_TOKEN=

# Astro site build configuration
ASTRO_BASE=/Open-Role-Radar/
ASTRO_SITE=https://kenjiifx.github.io

# Optional: override User-Agent for debugging (defaults to config/project.yml)
# OPENROLERADAR_USER_AGENT=OpenRoleRadar/1.0-dev (+http://localhost)

# Optional: limit sync for faster iteration
# OPENROLERADAR_MAX_SOURCES=5
